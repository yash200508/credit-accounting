# Local public client configuration placeholders.
# Obtain local development values from the pinned Supabase CLI status output.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key

# Never commit a real Supabase service-role key or place it in JavaFX,
# Flutter, browser-executed Next.js code, mobile bundles, logs, or screenshots.
# Server-only workflows must inject that secret from an environment secret store.
